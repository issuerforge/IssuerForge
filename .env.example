# ── Мережа ────────────────────────────────────────────────────────────────────
# Демо і розробка — devnet. Мейннет-ендпоінта тут немає навмисно: у цьому проєкті
# немає жодної операції, яку можна виконати в мейннеті без окремого рішення.
DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_ME

# ── Програма ──────────────────────────────────────────────────────────────────
PROGRAM_ID=REPLACE_ME
# Скарбниця платформи: сюди йде комісія з емісії й погашення (FR-038).
PLATFORM_TREASURY=REPLACE_ME

# ── Операційний ключ платформи ────────────────────────────────────────────────
# Приватний ключ ed25519, base58. Живе ТІЛЬКИ в процесі api.
# Його повноваження обмежені ончейн (delegation_mask): розморожування рахунків,
# оновлення власного реєстру статусів, сетлмент погашень. Емісія, вилучення,
# пауза й зміна політики йому недоступні навіть при компрометації (FR-035a).
OPERATIONAL_SECRET_KEY=REPLACE_ME

# ── База ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:6543/issuerforge

# ── Вхід у консоль ────────────────────────────────────────────────────────────
PRIVY_APP_ID=REPLACE_ME
PRIVY_APP_SECRET=REPLACE_ME

# ── API ───────────────────────────────────────────────────────────────────────
PORT=8787
LOG_LEVEL=info
# Походження сторінок, яким дозволено читати api. Кілька — через кому.
WEB_ORIGIN=http://localhost:5173

# ── Коридор погашення ─────────────────────────────────────────────────────────
# Фікстурний партнер: детермінований сервіс, реальних грошей не рухає (M4).
OFFRAMP_BASE_URL=http://localhost:8788

# ── Web ───────────────────────────────────────────────────────────────────────
# Читається під час збірки і потрапляє в бандл — секретів тут бути не може.
VITE_API_URL=http://localhost:8787
VITE_PRIVY_APP_ID=REPLACE_ME
