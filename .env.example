# ── Network ──────────────────────────────────────────────────────────────────
# Demo and development run on devnet. There is deliberately no mainnet endpoint
# here: nothing in this project may be executed on mainnet without a separate
# decision.
DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_ME

# ── Program ──────────────────────────────────────────────────────────────────
# The program address is deliberately absent: it comes only from the vendored
# IDL (`packages/chain`). A second address in the environment would create the
# state "IDL from one deploy, address from another", which nothing can catch.
# Platform treasury: receives the fee on issuance and redemption (FR-038).
PLATFORM_TREASURY=REPLACE_ME

# ── Platform operational key ─────────────────────────────────────────────────
# ed25519 secret key, base58. Lives ONLY in the api process.
# Its powers are bounded on chain (delegation_mask): thawing accounts, updating
# the issuer's own status register, settling redemptions. Minting, seizing,
# pausing and policy changes are out of its reach even if it is compromised
# (FR-035a).
OPERATIONAL_SECRET_KEY=REPLACE_ME

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:6543/issuerforge

# ── Console login ────────────────────────────────────────────────────────────
PRIVY_APP_ID=REPLACE_ME
PRIVY_APP_SECRET=REPLACE_ME
# The app's ES256 public key (Privy → Settings → JWT verification key).
# Token signatures are verified against it locally, without calling Privy. A
# multi-line PEM is entered as one line with \n in the hosting panel — the api
# restores the line breaks itself.
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
# No need to change; exists so that a change of Privy's host is not a code change.
# The demo (`tools/demo --api`) relies on exactly this seam: it starts a fixture
# that answers the same request and points this at `http://localhost:8788`.
# The run's wallets are generated a second before the request, so a live Privy
# cannot know them — and the authentication code stays unchanged and still
# verifies the signature itself.
PRIVY_API_URL=https://auth.privy.io

# The private half of the key whose public half is in PRIVY_VERIFICATION_KEY.
# Needed ONLY by the demo and ONLY with the fixture login: it signs the token in
# place of Privy. Deployments do not have this variable — Privy signs there.
# Format: PEM PKCS#8 (EC P-256), one line with \n, like the verification key.
# No sample here on purpose: a line carrying a private-key header in a committed
# file is exactly what the repository guard looks for, and rightly so.
LOGIN_SIGNING_KEY=REPLACE_ME

# ── API ──────────────────────────────────────────────────────────────────────
PORT=8787
LOG_LEVEL=info
# Origins allowed to read the api. Several — comma-separated.
WEB_ORIGIN=http://localhost:5173

# ── Redemption corridor ──────────────────────────────────────────────────────
# Fixture partner: a deterministic service that moves no real money (M4).
OFFRAMP_BASE_URL=http://localhost:8788

# ── Web ──────────────────────────────────────────────────────────────────────
# Read at build time and bundled — no secrets can live here.
VITE_API_URL=http://localhost:8787
VITE_PRIVY_APP_ID=REPLACE_ME
# The node the console itself sends signed transactions to. Public and keyless:
# everyone who opens the page sees this address. The paid node with a key stays
# in DEVNET_RPC_URL, i.e. on the api side only.
VITE_DEVNET_RPC_URL=https://api.devnet.solana.com
